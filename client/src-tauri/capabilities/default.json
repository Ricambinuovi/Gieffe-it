{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi delle finestre di Gieffe-it",
  "windows": ["postit", "login", "nuovo", "inviati", "storico", "impostazioni"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
