{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gieffe-it",
  "version": "0.1.0",
  "identifier": "it.gieffecar.gieffe-it",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Post-it digitali per la comunicazione interna",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Gieffe-it mostra sul PC dei colleghi i messaggi rapidi della sede, come post-it digitali.",
    "linux": {
      "deb": {
        "depends": [],
        "section": "utils"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
